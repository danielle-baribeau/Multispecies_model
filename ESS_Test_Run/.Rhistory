prop.bm.stock.bfg = bm.stock/bm.bfg)
bm.final.b <- as.data.frame(bm.final.b)
bm.best.b <- bm.final.b |> collapse::fsubset(Year %in% yrs)
bm.med <- stocks
colnames(bm.med)[colnames(bm.med) == "code"] <- "Stock"
colnames(bm.med)[colnames(bm.med) == "year"] <- "Year"
colnames(bm.med)[colnames(bm.med) == "common"] <- "Species"
colnames(bm.med)[colnames(bm.med) == "pop.bm"] <- "bm"
#add medium/broad functional groups
bm.med$BFG <- NULL
for (i in 1:nrow(bm.med)){
if (bm.med$FG[i] == "MP" || bm.med$FG[i] == "MBZ"){
bm.med$BFG[i] <- "M"
}
if (bm.med$FG[i] == "LP"){
bm.med$BFG[i] <- "LP"
}
if (bm.med$FG[i] == "LB"){
bm.med$BFG[i] <- "LB"
}
}
bm.tot.m <- bm.med |> collapse::fgroup_by(Stock,Year,BFG,Species) |>
collapse::fsummarize(bm = sum(bm,na.rm=T))
#functional group biomass and numbers.
mfg.bm <- bm.tot.m |> collapse::fgroup_by(Year,BFG) |>
collapse::fsummarize(bm.mfg = sum(bm))
# All the bm together
mfg.eco.bm <- left_join(mfg.bm, eco.tot.bm, by = "Year")
mfg.eco.bm$prop.eco.mfg <- mfg.eco.bm$bm.mfg/mfg.eco.bm$bm.eco
#proportions add up to 1!
# Now we combine the ecosystem results with the stock biomass's
bm.final.m <- left_join(bm.tot.m,mfg.eco.bm,by=c("Year","BFG"))
names(bm.final.m) <- c("Stock","Year","MFG","species","bm.stock","bm.mfg",'bm.eco',
'prop.eco.mfg')
# Get the proportion of the total biomass each stock accounts for
bm.final.m <- bm.final.m |> collapse::fmutate(prop.bm.stock.eco = bm.stock/bm.eco,
prop.bm.stock.mfg = bm.stock/bm.mfg)
bm.final.m <- as.data.frame(bm.final.m)
bm.best.m <- bm.final.m |> collapse::fsubset(Year %in% yrs)
eco.tot.bm.best <- eco.tot.bm |> collapse::fsubset(Year %in% yrs)
fg.bm.best <- fg.bm |> collapse::fsubset(Year %in% yrs)
bfg.bm.best <- bfg.bm |> collapse::fsubset(Year %in% yrs)
mfg.bm.best <- mfg.bm |> collapse::fsubset(Year %in% yrs)
eco.tot.bm.best
com.bm <- eco.tot.bm.best$bm.eco
me.com.bm <- median(com.bm)
colnames(b.env)
#get medians for each scenario
med.com.benv <- b.env |>  collapse::fgroup_by(year,stock,fg) |> collapse::fsummarize(med = median(bm.com,na.rm=T))
med.com.benv
#get medians for each scenario
med.com.benv <- b.env |>  collapse::fgroup_by(year) |> collapse::fsummarize(med = median(bm.com,na.rm=T))
med.com.benv
com.bm
com.bm <- data.frame(year = 2000:2017, bm.com = eco.tot.bm.best$bm.eco)
#get medians for each scenario
med.com.benv <- b.env |>  collapse::fgroup_by(year) |> collapse::fsummarize(med = median(bm.com,na.rm=T))
med.com.bnull <- b.null |>  collapse::fgroup_by(year) |> collapse::fsummarize(med = median(bm.com,na.rm=T))
med.com.tenv <- t.env |>  collapse::fgroup_by(year) |> collapse::fsummarize(med = median(bm.com,na.rm=T))
med.com.tnull <- t.null |>  collapse::fgroup_by(year) |> collapse::fsummarize(med = median(bm.com,na.rm=T))
#what will go into function
hist <- com.bm
one <- med.com.benv
two <- med.com.bnull
three <- med.com.tenv
four <- med.com.tnull
#call it ts.med(requires data frames with year and median of historical data and each scenario)
ggplot(hist) + geom_line(aes(x = year, y = bm.com/1000000)) +
geom_vline(xintercept = 2017, linetype = 2) +
geom_line(data = one, aes(x = year, y = med/1000000), colour = "#BDD7FB") +
geom_line(data = two, aes(x = year, y = med/1000000), colour = "#0070B2") +
geom_line(data = three, aes(x = year, y = med/1000000), colour = "#FAE149") +
geom_line(data = four, aes(x = year, y = med/1000000), colour = "#E6D159") +
labs(x = "Year", y = "Community biomass (millions of kg)") +
theme(axis.text.x = element_text(size=14, angle=45),
axis.text.y = element_text(size=14))
ggplot(hist) + geom_line(aes(x = year, y = bm.com/1000000)) +
geom_vline(xintercept = 2017, linetype = 2) +
