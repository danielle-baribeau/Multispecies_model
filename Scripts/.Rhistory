median.bm <- NULL
for (i in unique(bm.best.m$species)){
dat <- bm.best.b[bm.best.m$species == i,]
dat$med.bm <- median(dat$bm.stock)
median.bm[[i]] <- dat
}
med.bm <- do.call("rbind", median.bm)
