#### Lambdas - 1 year ####
lam.ed.ts <- bm.yrs[order(bm.yrs$code), ]
stocks <- unique(lam.ed.ts$code)
year.minus.one <- NULL
year.minus.one.stock <- NULL
#add in the year.minus.one column
for (s in stocks){
lam.ed.stock <- lam.ed.ts |> collapse :: fsubset(code == s)
year.minus.one.stock <- c(NA, lam.ed.stock$pop.bm[1:(length(lam.ed.stock$year)-1)])
year.minus.one <- c(year.minus.one, year.minus.one.stock)
year.minus.one.stock <- NULL
}#end stock loop
lam.ed.ts$year.minus.one <- year.minus.one
#fill in lambdas
lam.ed.ts$lambda <- c(rep(0,length(bm.yrs$year)))
count.lambda <- 1
for (l in lam.ed.ts$lambda){
lam.ed.ts$lambda[count.lambda] <-
(lam.ed.ts$full.bm[count.lambda]/lam.ed.ts$year.minus.one[count.lambda])
count.lambda <- count.lambda + 1
}
#remove NAs
#lam.ed.ts <- na.omit(lam.ed.ts)
summary(lam.ed.ts$lambda[lam.ed.ts$code == 11 & lam.ed.ts$year %in% 2000:2017])
