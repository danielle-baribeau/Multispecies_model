"w.flounder", "pollock", "w.hake", "s.hake",
"monkfish", "sculpin", "wolffish"))
removals$rv.code <- 0
for (i in 1:nrow(removals)){
r.code <- removals$SPECIES_CODE[i]
removals$rv.code[i] <- code.key$rv.code[code.key$rem.code == r.code]
}
#going with July as 1-year mark to match majority of survey tows
#1 year of removals for biomass in year n will be August n-1 to July n
#so biomass 2003 will be associated with removals from August 2002-July 2003
#for what years do we have removals?
unique(removals$YEAR_LANDED)
#Removals data run from Jan 2001 to 2026; using 2001-2017 for input time series
#biomass time series runs from 2000-2017
#only have Jan 2001 - July 2001 for 2001 biomass
#7 months of data available, so multiply this by (12/7) to get estimate for full year
#no removals for 2000, so approximating 2001 removals as representative of 2000
#pop. were managed under TAC at this time and TACs don't change annually
#get right years for biomass and removals time series
yrs <- c(2000:2017)
bm.yrs <- tot.bm.ed[tot.bm.ed$year %in% yrs,]
rem.yrs <- removals[removals$YEAR_LANDED %in% yrs,]
#make new column in biomass ts to store removals
bm.yrs$removals <- 0
#sort years in descending order
yrs.desc <- sort(yrs, decreasing = TRUE)
#store "special years"
special.yrs = c(2000, 2001)
#start filling in removals
for (s in spec.list){
#pull out stock-specific data from removals df
s.rem <- rem.yrs[rem.yrs$rv.code == s,]
#sort stock data years in descending order (most recent years first)
s.rem <- s.rem[order(s.rem$YEAR_LANDED, decreasing = TRUE),]
#go through each year, sum up removals and add to bm.yrs
for (t in yrs.desc){
#check for special years (2000 and 2001); if not, do standard process
if (t %in% special.yrs){
if (t == 2001){
#ONLY have current year for 2001:
curr.y.rem <- s.rem[s.rem$YEAR_LANDED == t,]
curr.y.rem <- curr.y.rem[curr.y.rem$month %in% c(1:7),]
#estimate removals
ann.rem <- (12/7)*(sum(curr.y.rem$RND_WEIGHT_KGS))
rem.2001 <- ann.rem
#add
}#end 2001 loop
if (t == 2000){
#estimate this as the same as 2001:
ann.rem <- rem.2001
#reset 2001 placeholder
rem.2001 <- NULL
}#end 2000 loop
} else {
#pull out months of interest for that year
#August to December of year t - 1 and January to July of year t
#for year t:
curr.y.rem <- s.rem[s.rem$YEAR_LANDED == t,]
curr.y.rem <- curr.y.rem[curr.y.rem$month %in% c(1:7),]
#for year t - 1:
prev.y.rem <- s.rem[s.rem$YEAR_LANDED == t - 1,]
prev.y.rem <- prev.y.rem[prev.y.rem$month %in% c(8:12),]
#get total removals
ann.rem <- (sum(curr.y.rem$RND_WEIGHT_KGS)) + (sum(prev.y.rem$RND_WEIGHT_KGS))
}#end "regular year" loop
#add total removals into biomass data frame
bm.yrs$removals[bm.yrs$code == s & bm.yrs$year == t] <- ann.rem
#reset objects
curr.y.rem <- NULL
prev.y.rem <- NULL
ann.rem <- NULL
}#end of years loop
}#end of total annual removals loop
#checked cod and sculpin, it works!!!!
#get median/mean total average removals for stocks
rem.sum <- data.frame(code = spec, med.rem = 0, avg.rem = 0)
rem.spec <- NULL
for (i in spec){
#pull out species-specific data
rem.spec <- bm.yrs[bm.yrs$code == i,]
#get median removals for the species
rem.sum$med.rem[rem.sum$code == i] <- median(rem.spec$removals)
#get mean removals for the species
rem.sum$avg.rem[rem.sum$code == i] <- mean(rem.spec$removals)
}
#add removals to survey biomass in order to get full population biomass
bm.yrs$full.bm <- bm.yrs$pop.bm + bm.yrs$removals
### examine historical exploitation rates and removals ###
