#summarize removals
#11/15 stocks - no removals for longfin hake, either skate or sea raven
rem_sum <- removals |> group_by(SPECIES_NAME) |> summarize(tot.rem = sum(RND_WEIGHT_KGS, na.rm = T)) |> ungroup()
rem <- rem_sum[order(rem_sum$tot.rem, decreasing = T),]
for (i in 1:nrow(rem)){
if (rem$SPECIES_NAME[i] == "GREYSOLE/WITCH") rem$SPECIES_NAME[i] <- "WITCH FLOUNDER"
if (rem$SPECIES_NAME[i] == "COD") rem$SPECIES_NAME[i] <- "ATLANTIC COD"
if (rem$SPECIES_NAME[i] == "WOLFFISH, STRIPED") rem$SPECIES_NAME[i] <- "ATLANTIC WOLFFISH"
}
rem$SPECIES_NAME <- factor(rem$SPECIES_NAME, levels=c("SILVER HAKE", "REDFISH",
"POLLOCK", "AMERICAN PLAICE", "WITCH FLOUNDER", "ATLANTIC COD",
"HADDOCK", "WHITE HAKE", "MONKFISH", "SCULPIN", "ATLANTIC WOLFFISH"))
