"M", "M", "M", "LP"))
fished.hist <- merge(fished.hist, stock.names, by = "code")
ggplot(bm.yrs[bm.yrs$code == 11 & bm.yrs$year %in% 2000:2017,]) + geom_line(aes(x = year, y = full.bm))
