fished.rem <- rem.sum[rem.sum$avg.rem != 0,]
fished.hist <- bm.yrs[bm.yrs$code %in% fished.rem$code,]
#determine exploitation rate
fished.hist$u <- fished.hist$removals/fished.hist$full.bm
#add stock names to data frame
